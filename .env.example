# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Only variables prefixed with EXPO_PUBLIC_ are embedded in the client bundle.
# The Supabase anon key is safe to ship because Row Level Security is enforced
# server-side; the service-role key must NEVER appear in this file.

EXPO_PUBLIC_SUPABASE_URL=https://caulzunfbbsifftfigou.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Fv-DIdDJmbKnXhTZRjtVOA_PD-LN9t2

# Public https URL where the privacy policy markdown is published.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://tushar.github.io/expense-counter/privacy-policy
EXPO_PUBLIC_TERMS_URL=https://tushar.github.io/expense-counter/terms
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://tushar.github.io/expense-counter/account-deletion

# Written automatically by `eas init`. Do not hand-edit.
EAS_PROJECT_ID=

# Set by EAS build profiles in eas.json (development | preview | production).
# Only define this locally if you run a dev-client build by hand.
APP_VARIANT=production
