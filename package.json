{
  "name": "expense-counter",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:splits": "node --experimental-strip-types --test src/lib/splits.test.mjs",
    "test:money": "node --experimental-strip-types --test src/lib/money.test.mjs",
    "test:db": "node --experimental-strip-types --test src/lib/db.test.mjs",
    "test": "npm run test:splits && npm run test:money && npm run test:db",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "submit:prod": "eas submit --profile production --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:prod:ios": "eas build --profile production --platform ios",
    "submit:prod:ios": "eas submit --profile production --platform ios"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^4.1.0",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
